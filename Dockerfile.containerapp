# syntax=docker/dockerfile:1
#
# LightRAG — Azure Container Apps optimized image
#
# Uses Azure VM (PostgreSQL + pgvector + AGE) for storage and
# Azure OpenAI Service (GPT-4.1 + text-embedding-3-large) for LLM / embeddings.
# The image ships without heavyweight offline extras; only the API + core PG
# driver are needed because managed Azure services handle the rest.
#
# Build:
#   docker build -f Dockerfile.containerapp -t lightrag-containerapp .
#
# ACR Build:
#   az acr build --registry <acr-name> --image cpqai:latest -f Dockerfile.containerapp .

# ── Stage 1: Frontend ───────────────────────────────────────────────
FROM oven/bun:1 AS frontend-builder

WORKDIR /app
COPY lightrag_webui/ ./lightrag_webui/

RUN --mount=type=cache,target=/root/.bun/install/cache \
    cd lightrag_webui \
    && bun install --frozen-lockfile \
    && bun run build

# ── Stage 2: Python dependencies ────────────────────────────────────
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    UV_SYSTEM_PYTHON=1 \
    UV_COMPILE_BYTECODE=1

WORKDIR /app

# System deps (Rust needed by some wheels like tiktoken)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl build-essential pkg-config \
    && rm -rf /var/lib/apt/lists/* \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y

ENV PATH="/root/.cargo/bin:/root/.local/bin:${PATH}"

RUN mkdir -p /root/.local/share/uv

# Copy project metadata first (layer cache)
COPY pyproject.toml setup.py uv.lock ./

# Install deps without the project itself — better caching
RUN --mount=type=cache,target=/root/.local/share/uv \
    uv sync --frozen --no-dev --extra api --no-install-project --no-editable

# Copy source + frontend build
COPY lightrag/ ./lightrag/
COPY --from=frontend-builder /app/lightrag/api/webui ./lightrag/api/webui

# Full sync with project
RUN --mount=type=cache,target=/root/.local/share/uv \
    uv sync --frozen --no-dev --extra api --no-editable \
    && /app/.venv/bin/python -m ensurepip --upgrade

# Pre-populate tiktoken cache (needed offline inside the container)
RUN mkdir -p /app/data/tiktoken \
    && uv run lightrag-download-cache --cache-dir /app/data/tiktoken || status=$?; \
    if [ -n "${status:-}" ] && [ "$status" -ne 0 ] && [ "$status" -ne 2 ]; then exit "$status"; fi

# ── Stage 3: Final runtime image ────────────────────────────────────
FROM python:3.12-slim

WORKDIR /app

# uv for any runtime package management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
ENV UV_SYSTEM_PYTHON=1

# Copy venv, installed packages and application code
COPY --from=builder /root/.local /root/.local
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/lightrag ./lightrag
COPY pyproject.toml setup.py uv.lock ./

ENV PATH=/app/.venv/bin:/root/.local/bin:$PATH

RUN --mount=type=cache,target=/root/.local/share/uv \
    uv sync --frozen --no-dev --extra api --no-editable \
    && /app/.venv/bin/python -m ensurepip --upgrade

# Pre-install Azure OpenAI SDK + PG drivers to avoid runtime installs
RUN /app/.venv/bin/python -m pip install --no-cache-dir openai asyncpg pgvector

# Data directories
RUN mkdir -p /app/data/rag_storage /app/data/inputs /app/data/tiktoken
COPY --from=builder /app/data/tiktoken /app/data/tiktoken

# ── Environment defaults for Container Apps ──────────────────────────
ENV TIKTOKEN_CACHE_DIR=/app/data/tiktoken \
    WORKING_DIR=/app/data/rag_storage \
    INPUT_DIR=/app/data/inputs \
    # Container Apps uses PORT=8080
    PORT=8080 \
    HOST=0.0.0.0 \
    # All four storage backends → PostgreSQL
    LIGHTRAG_KV_STORAGE=PGKVStorage \
    LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage \
    LIGHTRAG_GRAPH_STORAGE=PGGraphStorage \
    LIGHTRAG_VECTOR_STORAGE=PGVectorStorage \
    # Azure OpenAI as LLM + embedding provider
    LLM_BINDING=azure_openai \
    LLM_MODEL=gpt-4.1 \
    AZURE_OPENAI_DEPLOYMENT=gpt-4.1 \
    AZURE_OPENAI_API_VERSION=2024-08-01-preview \
    EMBEDDING_BINDING=azure_openai \
    EMBEDDING_MODEL=text-embedding-3-large \
    AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large \
    AZURE_EMBEDDING_API_VERSION=2023-05-15 \
    EMBEDDING_DIM=1536

# Container Apps uses PORT=8080 by default
EXPOSE 8080

ENTRYPOINT ["python", "-m", "lightrag.api.lightrag_server"]
