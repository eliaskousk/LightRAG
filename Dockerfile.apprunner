# syntax=docker/dockerfile:1
#
# LightRAG — AWS App Runner optimized image
#
# Uses EC2 instance (PostgreSQL + pgvector + AGE) for storage and
# Amazon Bedrock (Claude Sonnet 4.6 + Titan Embed V2) for LLM / embeddings.
# The image ships without heavyweight offline extras; only the API + core PG
# driver are needed because managed AWS services handle the rest.
#
# Build:
#   docker build -f Dockerfile.apprunner -t lightrag-apprunner .
#
# CodeBuild:
#   See deploy/aws/buildspec.yml

# ── Stage 1: Frontend ───────────────────────────────────────────────
# Use Node from ECR Public (no Docker Hub rate limits in CodeBuild)
# and install Bun as an npm package for the build toolchain.
FROM public.ecr.aws/docker/library/node:22-slim AS frontend-builder

RUN npm install -g bun

WORKDIR /app
COPY lightrag_webui/ ./lightrag_webui/

RUN --mount=type=cache,target=/root/.bun/install/cache \
    cd lightrag_webui \
    && bun install --frozen-lockfile \
    && bun run build

# ── Stage 2: Python dependencies ────────────────────────────────────
FROM public.ecr.aws/docker/library/python:3.12-slim-bookworm AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    UV_SYSTEM_PYTHON=1 \
    UV_COMPILE_BYTECODE=1

WORKDIR /app

# System deps (Rust needed by some wheels like tiktoken) + uv
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl build-essential pkg-config \
    && rm -rf /var/lib/apt/lists/* \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
    && curl -LsSf https://astral.sh/uv/install.sh | sh

ENV PATH="/root/.cargo/bin:/root/.local/bin:${PATH}"

RUN mkdir -p /root/.local/share/uv

# Copy project metadata first (layer cache)
COPY pyproject.toml setup.py uv.lock ./

# Install deps without the project itself — better caching
RUN --mount=type=cache,target=/root/.local/share/uv \
    uv sync --frozen --no-dev --extra api --no-install-project --no-editable

# Copy source + frontend build
COPY lightrag/ ./lightrag/
COPY --from=frontend-builder /app/lightrag/api/webui ./lightrag/api/webui

# Full sync with project
RUN --mount=type=cache,target=/root/.local/share/uv \
    uv sync --frozen --no-dev --extra api --no-editable \
    && /app/.venv/bin/python -m ensurepip --upgrade

# Pre-populate tiktoken cache (needed offline inside the container)
RUN mkdir -p /app/data/tiktoken \
    && uv run lightrag-download-cache --cache-dir /app/data/tiktoken || status=$?; \
    if [ -n "${status:-}" ] && [ "$status" -ne 0 ] && [ "$status" -ne 2 ]; then exit "$status"; fi

# ── Stage 3: Final runtime image ────────────────────────────────────
FROM public.ecr.aws/docker/library/python:3.12-slim

WORKDIR /app

# uv for any runtime package management
COPY --from=builder /root/.local/bin/uv /usr/local/bin/uv
ENV UV_SYSTEM_PYTHON=1

# Copy venv, installed packages and application code
COPY --from=builder /root/.local /root/.local
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/lightrag ./lightrag
COPY pyproject.toml setup.py uv.lock ./

ENV PATH=/app/.venv/bin:/root/.local/bin:$PATH

RUN --mount=type=cache,target=/root/.local/share/uv \
    uv sync --frozen --no-dev --extra api --no-editable \
    && /app/.venv/bin/python -m ensurepip --upgrade

# Pre-install Bedrock + PG drivers into the venv to avoid pipmaster cold-start
# installs at runtime (App Runner has no internet via VPC Connector)
RUN /app/.venv/bin/python -m pip install --no-cache-dir aioboto3 asyncpg pgvector

# Data directories
RUN mkdir -p /app/data/rag_storage /app/data/inputs /app/data/tiktoken
COPY --from=builder /app/data/tiktoken /app/data/tiktoken

# ── Environment defaults for App Runner ──────────────────────────────
ENV TIKTOKEN_CACHE_DIR=/app/data/tiktoken \
    WORKING_DIR=/app/data/rag_storage \
    INPUT_DIR=/app/data/inputs \
    # App Runner uses PORT=8080
    PORT=8080 \
    HOST=0.0.0.0 \
    # All four storage backends → PostgreSQL
    LIGHTRAG_KV_STORAGE=PGKVStorage \
    LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage \
    LIGHTRAG_GRAPH_STORAGE=PGGraphStorage \
    LIGHTRAG_VECTOR_STORAGE=PGVectorStorage \
    # Amazon Bedrock as LLM + embedding provider
    LLM_BINDING=aws_bedrock \
    LLM_MODEL=us.anthropic.claude-sonnet-4-6 \
    EMBEDDING_BINDING=aws_bedrock \
    EMBEDDING_MODEL=amazon.titan-embed-text-v2:0 \
    EMBEDDING_DIM=1024 \
    AWS_REGION=us-east-1

# App Runner uses PORT=8080 by default
EXPOSE 8080

ENTRYPOINT ["python", "-m", "lightrag.api.lightrag_server"]
