###############################################################################
# CPQAI — Amazon Web Services environment configuration
#
# Copy to .env and fill in your values before deploying.
# Secrets (passwords, API keys) should go in Secrets Manager instead of here.
###############################################################################

###########################
### Server Configuration
###########################
HOST=0.0.0.0
PORT=8080
WEBUI_TITLE='CPQAI Knowledge Base'

### Logging
LOG_LEVEL=INFO

###########################
### Bedrock (LLM)
###########################
LLM_BINDING=aws_bedrock
LLM_MODEL=us.anthropic.claude-sonnet-4-6
AWS_REGION=us-east-1
# No API keys needed — App Runner instance role provides Bedrock access

### LLM tuning
# LLM_TIMEOUT=180

###########################
### Bedrock (Embedding)
###########################
EMBEDDING_BINDING=aws_bedrock
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=8192
# EMBEDDING_TIMEOUT=30

###########################
### Storage — PostgreSQL EC2
###########################
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=PGGraphStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage

### PostgreSQL connection (TCP to EC2 instance via VPC Connector)
### Use the instance's private IP — App Runner reaches it via VPC Connector
POSTGRES_HOST=10.0.0.100
POSTGRES_PORT=5432
POSTGRES_USER=cpqai
POSTGRES_DATABASE=cpqai
### Password is injected from Secrets Manager — do not put it here
# POSTGRES_PASSWORD=

### Connection pool
POSTGRES_MAX_CONNECTIONS=12
POSTGRES_CONNECTION_RETRIES=10
POSTGRES_CONNECTION_RETRY_BACKOFF=3.0
POSTGRES_CONNECTION_RETRY_BACKOFF_MAX=30.0

### pgvector index
POSTGRES_ENABLE_VECTOR=true
POSTGRES_VECTOR_INDEX_TYPE=HNSW
POSTGRES_HNSW_M=16
POSTGRES_HNSW_EF=200

###########################
### Query Configuration
###########################
ENABLE_LLM_CACHE=true
# TOP_K=40
# CHUNK_TOP_K=20
# MAX_ENTITY_TOKENS=6000
# MAX_RELATION_TOKENS=8000
# MAX_TOTAL_TOKENS=30000

###########################
### Document Processing
###########################
ENABLE_LLM_CACHE_FOR_EXTRACT=true
SUMMARY_LANGUAGE=English
# CHUNK_SIZE=1200
# CHUNK_OVERLAP_SIZE=100

###########################
### Reranking (optional)
###########################
RERANK_BINDING=null
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_BINDING_HOST=http://your-reranker-endpoint/v1/rerank

###########################
### Concurrency
###########################
MAX_ASYNC=4
MAX_PARALLEL_INSERT=2
# EMBEDDING_FUNC_MAX_ASYNC=8

###########################
### Authentication
###########################
### API key is injected from Secrets Manager
# LIGHTRAG_API_KEY=
### Optional login accounts
# AUTH_ACCOUNTS='admin:changeme'
# TOKEN_SECRET=your-jwt-secret
# TOKEN_EXPIRE_HOURS=48
