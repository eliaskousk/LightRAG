###############################################################################
# CPQAI — Microsoft Azure environment configuration
#
# Copy to .env and fill in your values before deploying.
# Secrets (passwords, API keys) should go in Key Vault instead of here.
###############################################################################

###########################
### Server Configuration
###########################
HOST=0.0.0.0
PORT=8080
WEBUI_TITLE='CPQAI Knowledge Base'

### Logging
LOG_LEVEL=INFO

###########################
### Azure OpenAI (LLM)
###########################
LLM_BINDING=azure_openai
LLM_MODEL=gpt-4.1
AZURE_OPENAI_ENDPOINT=https://cpqai-openai.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-08-01-preview
# API key is injected from Key Vault — do not put it here
# AZURE_OPENAI_API_KEY=

### LLM tuning
# LLM_TIMEOUT=180

###########################
### Azure OpenAI (Embedding)
###########################
EMBEDDING_BINDING=azure_openai
EMBEDDING_MODEL=text-embedding-3-large
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_EMBEDDING_API_VERSION=2023-05-15
EMBEDDING_DIM=1536
EMBEDDING_TOKEN_LIMIT=8192
# EMBEDDING_TIMEOUT=30

###########################
### Storage — PostgreSQL VM
###########################
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=PGGraphStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage

### PostgreSQL connection (TCP to VM via VNet)
### Use the VM's private IP — Container Apps reaches it via VNet integration
POSTGRES_HOST=10.0.2.4
POSTGRES_PORT=5432
POSTGRES_USER=cpqai
POSTGRES_DATABASE=cpqai
### Password is injected from Key Vault — do not put it here
# POSTGRES_PASSWORD=

### Connection pool
POSTGRES_MAX_CONNECTIONS=12
POSTGRES_CONNECTION_RETRIES=10
POSTGRES_CONNECTION_RETRY_BACKOFF=3.0
POSTGRES_CONNECTION_RETRY_BACKOFF_MAX=30.0

### pgvector index
POSTGRES_ENABLE_VECTOR=true
POSTGRES_VECTOR_INDEX_TYPE=HNSW
POSTGRES_HNSW_M=16
POSTGRES_HNSW_EF=200

###########################
### Query Configuration
###########################
ENABLE_LLM_CACHE=true
# TOP_K=40
# CHUNK_TOP_K=20
# MAX_ENTITY_TOKENS=6000
# MAX_RELATION_TOKENS=8000
# MAX_TOTAL_TOKENS=30000

###########################
### Document Processing
###########################
ENABLE_LLM_CACHE_FOR_EXTRACT=true
SUMMARY_LANGUAGE=English
# CHUNK_SIZE=1200
# CHUNK_OVERLAP_SIZE=100

###########################
### Reranking (optional)
###########################
RERANK_BINDING=null
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_BINDING_HOST=http://your-reranker-endpoint/v1/rerank

###########################
### Concurrency
###########################
MAX_ASYNC=4
MAX_PARALLEL_INSERT=2
# EMBEDDING_FUNC_MAX_ASYNC=8

###########################
### Authentication
###########################
### API key is injected from Key Vault
# LIGHTRAG_API_KEY=
### Optional login accounts
# AUTH_ACCOUNTS='admin:changeme'
# TOKEN_SECRET=your-jwt-secret
# TOKEN_EXPIRE_HOURS=48
