###############################################################################
# CPQAI — Google Cloud Platform environment configuration
#
# Copy to .env and fill in your values before deploying.
# Secrets (passwords, API keys) should go in Secret Manager instead of here.
###############################################################################

###########################
### Server Configuration
###########################
HOST=0.0.0.0
PORT=8080
WEBUI_TITLE='CPQAI Knowledge Base'

### Logging
LOG_LEVEL=INFO

###########################
### Vertex AI (LLM)
###########################
LLM_BINDING=gemini
LLM_BINDING_HOST=DEFAULT_GEMINI_ENDPOINT
LLM_MODEL=gemini-3-flash-preview
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT='stromasys-projects'
GOOGLE_CLOUD_LOCATION=global
# No API key needed — Vertex AI uses the service account identity

### Gemini LLM tuning
# GEMINI_LLM_MAX_OUTPUT_TOKENS=9000
# GEMINI_LLM_TEMPERATURE=0.7
# LLM_TIMEOUT=180

###########################
### Vertex AI (Embedding)
###########################
EMBEDDING_BINDING=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536
EMBEDDING_SEND_DIM=true
EMBEDDING_TOKEN_LIMIT=2048
# EMBEDDING_TIMEOUT=30

###########################
### Storage — PostgreSQL VM
###########################
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=PGGraphStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage

### PostgreSQL connection (TCP to Compute Engine VM via VPC)
### Use the VM's internal IP — Cloud Run reaches it via Direct VPC egress
POSTGRES_HOST=10.128.0.2
POSTGRES_PORT=5432
POSTGRES_USER=cpqai
POSTGRES_DATABASE=cpqai
### Password is injected from Secret Manager — do not put it here
# POSTGRES_PASSWORD=

### Connection pool
POSTGRES_MAX_CONNECTIONS=12
POSTGRES_CONNECTION_RETRIES=10
POSTGRES_CONNECTION_RETRY_BACKOFF=3.0
POSTGRES_CONNECTION_RETRY_BACKOFF_MAX=30.0

### pgvector index
POSTGRES_ENABLE_VECTOR=true
POSTGRES_VECTOR_INDEX_TYPE=HNSW
POSTGRES_HNSW_M=16
POSTGRES_HNSW_EF=200

###########################
### Query Configuration
###########################
ENABLE_LLM_CACHE=true
# TOP_K=40
# CHUNK_TOP_K=20
# MAX_ENTITY_TOKENS=6000
# MAX_RELATION_TOKENS=8000
# MAX_TOTAL_TOKENS=30000

###########################
### Document Processing
###########################
ENABLE_LLM_CACHE_FOR_EXTRACT=true
SUMMARY_LANGUAGE=English
# CHUNK_SIZE=1200
# CHUNK_OVERLAP_SIZE=100

###########################
### Reranking (optional)
###########################
RERANK_BINDING=null
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_BINDING_HOST=http://your-reranker-endpoint/v1/rerank

###########################
### Concurrency
###########################
MAX_ASYNC=4
MAX_PARALLEL_INSERT=2
# EMBEDDING_FUNC_MAX_ASYNC=8

###########################
### Authentication
###########################
### API key is injected from Secret Manager
# LIGHTRAG_API_KEY=
### Optional login accounts
# AUTH_ACCOUNTS='admin:changeme'
# TOKEN_SECRET=your-jwt-secret
# TOKEN_EXPIRE_HOURS=48
